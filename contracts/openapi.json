  "components" : {
    "schemas" : {
      "AchievementForm" : {
        "type" : "object",
        "properties" : {
          "textEn" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          },
          "textPl" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "textEn", "textPl" ]
      },
      "ApiProblem" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "status", "title" ]
      },
      "ContactForm" : {
        "type" : "object",
        "properties" : {
          "contactRef" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "pattern" : "^[^@\\s]+@[^@\\s]+$"
          },
          "locale" : {
            "type" : "string",
            "pattern" : "en|pl"
          },
          "message" : {
            "type" : "string",
            "maxLength" : 5000,
            "minLength" : 10
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "email", "locale", "message", "name" ]
      },
      "CredentialForm" : {
        "type" : "object",
        "properties" : {
          "endYear" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 2100,
            "minimum" : 1950
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "issuer" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "CERTIFICATION", "EDUCATION" ]
          },
          "sortOrder" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "startYear" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 2100,
            "minimum" : 1950
          },
          "titleEn" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "titlePl" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "url" : {
            "type" : "string",
            "maxLength" : 300,
            "minLength" : 0,
            "pattern" : "^https://\\S+$"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "issuer", "kind", "sortOrder", "titleEn", "titlePl" ]
      },
      "CredentialView" : {
        "type" : "object",
        "properties" : {
          "endYear" : {
            "type" : "integer",
            "format" : "int32"
          },
          "issuer" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "CERTIFICATION", "EDUCATION" ]
          },
          "startYear" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          }
        },
        "required" : [ "issuer", "kind", "title" ]
      },
      "ExperienceForm" : {
        "type" : "object",
        "properties" : {
          "achievements" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AchievementForm"
            },
            "maxItems" : 50,
            "minItems" : 0
          },
          "client" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "employer" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "end" : {
            "type" : "string",
            "pattern" : "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "locationEn" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "locationPl" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "published" : {
            "type" : "boolean"
          },
          "roleEn" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "rolePl" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "start" : {
            "type" : "string",
            "pattern" : "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "achievements", "employer", "published", "roleEn", "rolePl", "start" ]
      },
      "ExperienceView" : {
        "type" : "object",
        "properties" : {
          "achievements" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "client" : {
            "type" : "string"
          },
          "employer" : {
            "type" : "string"
          },
          "end" : {
            "type" : "string",
            "description" : "Null for the current role",
            "pattern" : "^\\d{4}-\\d{2}$"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "location" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string"
          },
          "start" : {
            "type" : "string",
            "example" : "2021-04",
            "pattern" : "^\\d{4}-\\d{2}$"
          }
        },
        "required" : [ "achievements", "employer", "id", "role", "start" ]
      },
      "FieldError" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "MessagePage" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MessageView"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "total" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "items", "page", "size", "total" ]
      },
      "MessageView" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "locale" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "readAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "createdAt", "email", "id", "locale", "message", "name" ]
      },
      "ProfileForm" : {
