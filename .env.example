# Copy to .env, which git ignores. Docker Compose reads it automatically.

# Use a long random value.
DB_PASSWORD=

# The admin panel login. The password must be random, 20 or more characters.
ADMIN_USERNAME=
# A bcrypt hash of the password, in single quotes because hashes contain $.
# Generate one in a POSIX shell. Type the password and press Enter; nothing is shown:
#   read -rs pw; printf '%s' "$pw" | docker run --rm -i httpd:2-alpine htpasswd -niBC 12 "" | tr -d ":\r\n"; echo; unset pw
ADMIN_PASSWORD_HASH=''

# Local run over plain HTTP.
# FOR A REAL DEPLOYMENT change all three: your domain, https://your-domain, and COOKIE_SECURE=true.
SITE_ADDRESS=:80
SITE_URL=http://localhost
COOKIE_SECURE=false

# Imports seed/content.json into an empty database. Existing content is never overwritten.
SEED_ENABLED=true

# Report published by CI, for the test results section. With a public GitHub repository this is
#   https://raw.githubusercontent.com/OWNER/REPOSITORY/quality-data/quality.json
# Leave empty to hide the section.
QUALITY_JSON_URL=

# Host ports. Change them if something else already uses 80 or 443.
HTTP_PORT=80
HTTPS_PORT=443
